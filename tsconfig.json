{
  "compilerOptions": {
    "rootDir": ".",
    "lib": ["ES2020"],
    "target": "ES6",
    "sourceMap": true,
    "composite": true,
    "incremental": true,
    "declaration": true,
    "declarationMap": true,
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "isolatedModules": true,
    "esModuleInterop": true,
    "outDir": "dist",
    "noEmit": true,
    "allowUnreachableCode": false,
    "noImplicitOverride": true,
    "module": "nodenext",
    "moduleResolution": "nodenext"
  },
  "include": ["src", "tests"]
}
